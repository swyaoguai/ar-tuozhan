{
  "name": "ar-tuozhan",
  "version": "0.10.0",
  "type": "module",
  "description": "DSH 插件：ar 渠道（agentrouter / ps.air-outer 两个中转站），带上 originator 请求头、模型可编辑，并内置 API Key 轮询（额度耗尽自动换下一个 key 并重试）+ 可视化管理界面。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "provider",
    "anthropic-messages",
    "key-pool",
    "key-rotation"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
