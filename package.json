{
  "name": "dsh-ag-channel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：只接管 ag 这一个模型渠道（agentrouter / ps.air-outer），带上 originator 请求头、四个模型与两个可切换的地址。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "provider",
    "anthropic-messages"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.4"
